rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function routeTitleOk() {
      let t = request.resource.data.title;
      return t is string && t.size() >= 1 && t.size() <= 300;
    }

    function routeRawInputOk() {
      let r = request.resource.data.rawInput;
      return r is string && r.size() >= 0 && r.size() <= 300000;
    }

    function routeStopsOk() {
      let s = request.resource.data.stops;
      return s is list && s.size() >= 0 && s.size() <= 220;
    }

    function routeActiveStopIdOk() {
      let d = request.resource.data;
      return !('activeStopId' in d)
        || d.activeStopId == null
        || d.activeStopId is string;
    }

    function routeWorkspaceOk() {
      let d = request.resource.data;
      return !('workspace' in d)
        || (d.workspace is string
            && (d.workspace == 'route' || d.workspace == 'mapOverview'));
    }

    function routeCreateOk() {
      let d = request.resource.data;
      return d.keys().hasAll(['title', 'rawInput', 'stops', 'createdAt', 'updatedAt'])
        && routeTitleOk()
        && routeRawInputOk()
        && routeStopsOk()
        && routeActiveStopIdOk()
        && routeWorkspaceOk()
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    function routeUpdateOk() {
      let d = request.resource.data;
      return d.keys().hasAll(['title', 'rawInput', 'stops', 'updatedAt'])
        && routeTitleOk()
        && routeRawInputOk()
        && routeStopsOk()
        && routeActiveStopIdOk()
        && routeWorkspaceOk()
        && d.updatedAt is timestamp;
    }

    match /users/{userId}/routes/{routeId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && routeCreateOk();

      allow update: if request.auth != null
        && request.auth.uid == userId
        && routeUpdateOk();

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /addressCache/{docId} {
      allow read: if true;

      allow create, update: if request.resource.data.keys().hasAll(['address', 'lat', 'lng', 'createdAt'])
        && request.resource.data.keys().hasOnly(['address', 'lat', 'lng', 'createdAt'])
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0
        && request.resource.data.address.size() < 500
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.lat >= -90
        && request.resource.data.lat <= 90
        && request.resource.data.lng >= -180
        && request.resource.data.lng <= 180
        && request.resource.data.createdAt is timestamp;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
